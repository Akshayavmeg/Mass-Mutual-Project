# Copy this file to .env and fill in real local values.
# .env must never be committed (see .gitignore) and must never contain
# real customer or banking data or production credentials.

ENVIRONMENT=development

# PostgreSQL connection string (ADR-0003). Placeholder credentials only.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mass_mutual_db

# Used for signing/hashing (e.g. JWT signing, see ADR-0007). Generate a real
# random value for any non-local environment; never reuse this placeholder.
SECRET_KEY=changeme-local-development-only

LOG_LEVEL=INFO

# Comma-separated list is not supported directly by pydantic-settings list
# parsing from .env; override via CORS_ORIGINS as a JSON array if needed, e.g.
# CORS_ORIGINS=["http://localhost:3000"]
